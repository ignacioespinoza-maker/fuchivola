{
  "builds": [
    {
      "src": "fuchivola/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "mi_app/static",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "mi_app/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "fuchivola/wsgi.py"
    }
  ]
}
